# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.abelsolutions.co.uk

# Public contact details — leave blank until confirmed (do not invent values)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_COMPANY_NUMBER=

# Show development placeholder projects outside production filtering
# Set to "true" only while designing layouts
NEXT_PUBLIC_SHOW_PLACEHOLDER_PROJECTS=false

# Email delivery — never commit real secrets
EMAIL_DELIVERY_ENABLED=false
CONTACT_INBOX_EMAIL=
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
